# ---- App ----
PORT=3000
# Dominio publico final (sem barra no final). Usado nos redirects OAuth e no link do pixel.
APP_PUBLIC_URL=https://seudominio.com.br
# Segredo para assinar o cookie de sessao. Gere um valor aleatorio longo (ex: openssl rand -hex 32)
SESSION_SECRET=

# ---- Login (usuario unico) ----
ADMIN_USER=teodosio
# Gere com: npm run setup:admin -- "sua-senha-aqui"  (grava um hash, nunca a senha em texto puro)
ADMIN_PASSWORD_HASH=

# ---- Google Ads (crie um app OAuth proprio no Google Cloud Console) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Developer token da sua conta Google Ads (Ferramentas > Central da API)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v22
# Preencha SOMENTE se o developer token acima foi obtido numa conta MCC
# (gerenciadora). É o ID de 10 dígitos da MCC, só números (sem hífen).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---- WhatsApp (D-API) ----
# Session ID e API Key NAO vao aqui: sao preenchidos dentro do proprio painel,
# na tela WhatsApp (ficam guardados no banco, nao em variavel de ambiente).
# So mude isso se a D-API usar uma URL base diferente da padrao.
DAPI_BASE_URL=https://api.d-api.cloud
# Chave que so voce e a D-API conhecem, usada para validar o webhook publico do WhatsApp
WHATSAPP_WEBHOOK_SECRET=
