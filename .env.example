# ---- App ----
PORT=3000
# Dominio publico final (sem barra no final). Usado nos redirects OAuth e no link do pixel.
APP_PUBLIC_URL=https://seudominio.com.br
# Segredo para assinar o cookie de sessao. Gere um valor aleatorio longo (ex: openssl rand -hex 32)
SESSION_SECRET=

# ---- Login (usuario unico) ----
ADMIN_USER=teodosio
# Gere com: npm run setup:admin -- "sua-senha-aqui"  (grava um hash, nunca a senha em texto puro)
ADMIN_PASSWORD_HASH=

# ---- Google Ads (crie um app OAuth proprio no Google Cloud Console) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Developer token da sua conta Google Ads (Ferramentas > Central da API)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v22
# Não é preciso configurar a MCC aqui: a tela Google Ads do painel deixa
# você escolher, entre as contas acessíveis, qual MCC/conta usar — funciona
# com qualquer uma que o e-mail conectado tiver acesso.

# ---- WhatsApp (D-API) ----
# Session ID e API Key de cada empresa NAO vao aqui: sao preenchidos dentro
# do proprio painel, na tela WhatsApp de cada empresa (ficam guardados no
# banco). O segredo do webhook tambem e gerado automaticamente por empresa
# (aparece na tela WhatsApp dela). So mude isso se a D-API usar uma URL base
# diferente da padrao.
DAPI_BASE_URL=https://api.d-api.cloud
# Chave de API da SUA CONTA D-API (painel > Chave de API). Usada só pelo
# botão "Criar sessão automaticamente" na tela WhatsApp de cada empresa —
# sem ela, o botão continua funcionando manualmente (colar sessionId/apiKey).
DAPI_ACCOUNT_API_KEY=
